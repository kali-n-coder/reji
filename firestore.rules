rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || customerStockDecrease();
    }

    function customerStockDecrease() {
      return resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.stock <= resource.data.stock;
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.items is list
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.paymentMethod in ['cash', 'paypay', 'other'];
      allow read: if isAdmin();
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
